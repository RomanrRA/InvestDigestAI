# Подключение к БД (docker-compose в корне репо поднимает Postgres на 127.0.0.1:5441)
DATABASE_URL=postgresql+psycopg://ai_invest:ai_invest@127.0.0.1:5441/ai_invest

# LLM через OpenRouter
OPENROUTER_API_KEY=
DIGEST_MODEL=deepseek/deepseek-chat

# Telegram-канал для автопостинга дайджеста (этап 0)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Канал в мессенджере MAX (опционально; токен — у @MasterBot, chat_id — команда max-chats)
MAX_BOT_TOKEN=
MAX_CHANNEL_ID=
